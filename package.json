{
  "name": "tennis-xpress",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:backend": "npm run test --workspace=@tennis-xpress/backend",
    "test:backend:integration": "npm run test:integration --workspace=@tennis-xpress/backend",
    "test:frontend": "npm run test --workspace=@tennis-xpress/frontend"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.6.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1"
  }
}
