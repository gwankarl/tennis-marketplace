# Required development database URL. Use only the development login here.
# URL-encode special characters in the local password.
DATABASE_URL=postgresql://tennis_xpress_dev:URL_ENCODED_PASSWORD@127.0.0.1:5432/tennis_xpress_dev
# Required only for the separately invoked PostgreSQL integration tests.
# Use the dedicated test login; URL-encode special characters in its password.
TEST_DATABASE_URL=postgresql://tennis_xpress_test:URL_ENCODED_PASSWORD@127.0.0.1:5432/tennis_xpress_test

# Optional API bind address and port.
HOST=127.0.0.1
PORT=3000

# Replace with the product-approved Terms version before accepting registrations.
TERMS_VERSION=replace-with-approved-terms-version

# Registration attempts per socket peer IP.
REGISTRATION_RATE_LIMIT_MAX=5
REGISTRATION_RATE_LIMIT_WINDOW_MS=900000

# Optional for normal backend startup. Required only by the explicit email check.
EMAIL_SMTP_HOST=sandbox.smtp.mailtrap.io
EMAIL_SMTP_PORT=2525
EMAIL_SMTP_USER=replace-with-mailtrap-sandbox-username
EMAIL_SMTP_PASSWORD=replace-with-mailtrap-sandbox-password
EMAIL_FROM_ADDRESS=tennis-xpress@example.test

# Optional; required only when explicitly creating or reading verification jobs.
# Generate the key locally. Do not commit it or send it in chat.
EMAIL_QUEUE_ENCRYPTION_KEY_ID=local-v1
EMAIL_QUEUE_ENCRYPTION_KEY=replace-with-generated-32-byte-base64-key
FRONTEND_ORIGIN=http://localhost:5173

# Read only by the separately started email worker.
EMAIL_WORKER_POLL_INTERVAL_MS=1000
EMAIL_WORKER_CONCURRENCY=2
EMAIL_WORKER_LEASE_MS=120000
EMAIL_WORKER_RETRY_BASE_MS=30000
EMAIL_WORKER_RETRY_MAX_MS=900000

# Resend limits: socket peer IP, account job count, and per-account cooldown.
RESEND_VERIFICATION_IP_RATE_LIMIT_MAX=5
RESEND_VERIFICATION_IP_RATE_LIMIT_WINDOW_MS=3600000
RESEND_VERIFICATION_ACCOUNT_MAX_PER_HOUR=5
RESEND_VERIFICATION_ACCOUNT_COOLDOWN_MS=60000

# Backend-only key used to HMAC private login rate-limit bucket keys.
# Generate locally and set the actual value only in ignored backend/.env.
LOGIN_RATE_LIMIT_HMAC_KEY=replace-with-generated-32-byte-base64url-key
LOGIN_RATE_LIMIT_IP_MAX=20
LOGIN_RATE_LIMIT_EMAIL_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000