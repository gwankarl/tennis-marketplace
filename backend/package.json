{
  "name": "@tennis-xpress/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "email:check": "tsx src/infrastructure/email/check-smtp.ts",
    "email:worker": "tsx src/workers/email-worker.ts",
    "db:check": "tsx src/db/check-connection.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.1",
    "@fastify/type-provider-zod": "1.0.3",
    "argon2": "0.45.1",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "nodemailer": "10.3.1",
    "pg": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
