{
  "name": "@tennis-xpress/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "build": "tsc",
    "db:check": "tsx src/db/check-connection.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
